# Claude Code local config
.claude/

# Python runtimes for Sibyl Memory and the ADK agent. Both are created by the
# operator (see docs/ai/api/deployment.md) and neither belongs in the tree:
# without this a single `git add -A` commits several thousand venv files.
.venv-sibyl/
.venv-adk/

# ADK's own runtime state: a session database and bytecode it writes beside the
# agent. Runtime artefacts, not source.
__pycache__/
*.pyc
agents/**/.adk/
