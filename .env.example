# ---------------------------------------------------------------------------
# Copy to .env at the repository root: cp .env.example .env
# Server-side entrypoints (API, migrations, drizzle-kit) read this file.
# ---------------------------------------------------------------------------

# Host port docker-compose publishes Postgres on (default 5436). 5432 and 5433
# collide with other local Postgres containers often enough that the default
# moved off them. If the API reads an empty database, check this port first:
# a wrong port connects successfully to the wrong server and reports healthy.
POSTGRES_PORT=5436

# Postgres connection string. Matches docker-compose.yml credentials.
# Point this at any managed Postgres to skip Docker entirely.
DATABASE_URL=postgresql://aura:aura@localhost:5436/aura_console

# Optional: maximum connections in the pg pool (default 10).
# DATABASE_POOL_MAX=10

# Port the Next.js web app listens on (default 3000).
WEB_PORT=3000

# Port the Hono API listens on (default 3001).
PORT=3001

# Comma-separated list of origins allowed to call the API cross-origin.
# Must include the web app's origin, WEB_PORT included.
CORS_ORIGINS=http://localhost:3000

# Base URL the web app uses to reach the API. Exposed to the browser.
NEXT_PUBLIC_API_URL=http://localhost:3001

# ---------------------------------------------------------------------------
# ACP runtime (apps/api, `pnpm --filter @aura/api acp`).
#
# Only the ACP worker reads these. The HTTP API and the web app run without
# them, so leave them unset unless you are running the worker.
#
# Base Sepolia or Base mainnet. The agent wallet is Privy-managed, so there is
# no EOA private key here and none to export: signing happens server-side and
# ACP_PRIVY_AUTHORIZATION_KEY authorizes the request. That key still grants
# signing on the wallet — treat it as a secret and never commit a filled-in
# .env.
# ---------------------------------------------------------------------------

# 84532 (Base Sepolia) or 8453 (Base mainnet, real funds). Every other chain id
# is rejected. This also selects the Privy app, so it must agree with
# ACP_SERVER_URL: the dev host below is testnet, api.acp.virtuals.io is
# production.
# ACP_CHAIN_ID=84532

# The agent's wallet address, from its page at https://app.virtuals.io/acp.
# ACP_WALLET_ADDRESS=0x...

# The Privy wallet id backing that address. Neither value can be derived from
# the other, so both are required.
# ACP_PRIVY_WALLET_ID=...

# Privy authorization key: base64 PKCS8, no PEM headers, usually handed over
# with a `wallet-auth:` prefix. Maps to the SDK's `signerPrivateKey`.
# ACP_PRIVY_AUTHORIZATION_KEY=wallet-auth:...

# Optional. Unset, the runtime uses the SDK's testnet Privy app, which matches
# the dev ACP host. Set only if Virtuals says your agent is under another app.
# ACP_PRIVY_APP_ID=

# EVM RPC endpoint for reads and transaction receipts.
# ACP_RPC_URL=https://sepolia.base.org

# ACP host. Use the dev host for testnet; https://api.acp.virtuals.io is
# production.
# ACP_SERVER_URL=https://api-dev.acp.virtuals.io

# Whether the ACP worker may execute operator authorizations (default false).
# When unset the runtime cannot move money at all, whatever is sitting in
# acp_spend_intents. The API has no authentication, so anyone who can reach the
# port can authorize a testnet spend — keep the port local.
# ACP_SPEND_ENABLED=false

# ---------------------------------------------------------------------------
# EconomyOS Agent Compute (apps/api, `pnpm --filter @aura/api acp:compute`).
#
# Optional and independent of the marketplace: the ACP worker runs without
# these, and compute works with no ACP variables set at all.
#
# Every completion is drawn from the agent's compute balance, which auto-top-up
# refills from the same wallet that funds ACP jobs. Treat the key as a spending
# credential, not a read token.
#
# https://os.virtuals.io/agent-identity/compute/overview
# ---------------------------------------------------------------------------

# Generated from the agent's Compute settings at https://app.virtuals.io/os.
# ACP_API_KEY=acp-...

# The compute endpoint. Defaults to the shared EconomyOS gateway; set it only
# if the dashboard issued your agent a different base URL.
# ACP_COMPUTE_BASE_URL=https://compute.virtuals.io/v1
# The operator's own agent. v0.1 is single-operator with no account model, so
# first-party access to episodes and memory diffs is established by deployment
# rather than by a session. A second operator needs real authentication.
AGENT_ID=agent_buyer_1

# Base URL of the Google ADK agent that answers operator questions, e.g.
# http://localhost:8000 for `adk api_server`. Leave it unset and the chat
# endpoint returns 503 agent_unavailable rather than inventing a reply.
# ADK_BASE_URL=http://localhost:8000

# How long to wait for the agent's first token before giving up.
ADK_TIMEOUT_MS=30000

# Sibyl Memory (optional, and unset by default on purpose).
# Sibyl ships as a Python package over a local SQLite file, so the API reaches
# it through tools/sibyl_bridge.py, which is read-only. Leave SIBYL_PYTHON unset
# and Sibyl is never consulted: retrieval passes the Postgres result through
# unchanged and reports `consulted: false` with the reason. That is not an
# error, because nothing claimed to look. Setting it opts this deployment in,
# and from then on a Sibyl that cannot answer is a memory failure rather than a
# silence — see docs/ai/api/memory.md.
#
# Sibyl needs Python 3.10 or newer (sibyl-memory-client declares
# Requires-Python: >=3.10). macOS still ships /usr/bin/python3 as 3.9, where the
# install fails, so name the interpreter explicitly rather than relying on
# whatever `python3` resolves to:
#
#   python3.11 -m venv .venv-sibyl          # 3.10+; 3.11 is what this repo uses
#   .venv-sibyl/bin/pip install sibyl-memory-client
#   .venv-sibyl/bin/python -c "import sibyl_memory_client as s; print(s.__version__)"
#
# .venv-sibyl/ and .venv-adk/ are gitignored. Neither belongs in a commit.
#
# The database is NOT created on demand. MemoryClient.local() would create the
# file, but the bridge checks for it first and reports `db_absent` instead,
# because a store conjured on a read turns "no memory here" into "an empty
# memory" — two different claims. Create one before pointing the API at it:
#
#   .venv-sibyl/bin/python tools/sibyl_seed.py     # writes the labelled fixture
#
# That seed script is the only writer in the repo and is run by hand; no request
# can reach it. The free tier needs no account: `init` only binds one.
# SIBYL_PYTHON=.venv-sibyl/bin/python
# SIBYL_DB_PATH=~/.sibyl-memory/memory.db
#
# Sibyl isolates by tenant and the bridge refuses to guess one: the API always
# reads as its own AGENT_ID. Seed the fixture under that same tenant, or the
# records are real, correct, and permanently invisible:
#   SIBYL_DB_PATH=~/.sibyl-memory/memory.db \
#     .venv-sibyl/bin/python tools/sibyl_seed.py --tenant agent_buyer_1
# SIBYL_BRIDGE=tools/sibyl_bridge.py
# SIBYL_TIMEOUT_MS=5000

# Google ADK agent. Optional to configure, required to use the Console: with
# nothing on :8000 every chat returns 503 and every surface warns.
#   python3.11 -m venv .venv-adk && .venv-adk/bin/pip install google-adk
#   pnpm agent          # wraps the command below and checks its prerequisites
# Vertex needs `gcloud auth application-default login` and the aiplatform API
# enabled. Leave ADK_BASE_URL unset and the chat reports the agent unavailable
# rather than answering from nothing.
# ADK_BASE_URL=http://localhost:8000
