# ---------------------------------------------------------------------------
# Copy to .env at the repository root: cp .env.example .env
# Server-side entrypoints (API, migrations, drizzle-kit) read this file.
# ---------------------------------------------------------------------------

# Host port docker-compose publishes Postgres on (default 5433, to avoid
# colliding with a Postgres already running on the conventional 5432).
POSTGRES_PORT=5433

# Postgres connection string. Matches docker-compose.yml credentials.
# Point this at any managed Postgres to skip Docker entirely.
DATABASE_URL=postgresql://aura:aura@localhost:5433/aura_console

# Optional: maximum connections in the pg pool (default 10).
# DATABASE_POOL_MAX=10

# Port the Next.js web app listens on (default 3000).
WEB_PORT=3000

# Port the Hono API listens on (default 3001).
PORT=3001

# Comma-separated list of origins allowed to call the API cross-origin.
# Must include the web app's origin, WEB_PORT included.
CORS_ORIGINS=http://localhost:3000

# Base URL the web app uses to reach the API. Exposed to the browser.
NEXT_PUBLIC_API_URL=http://localhost:3001

# ---------------------------------------------------------------------------
# ACP runtime (apps/api, `pnpm --filter @aura/api acp`).
#
# Only the ACP worker reads these. The HTTP API and the web app run without
# them, so leave them unset unless you are running the worker.
#
# Base Sepolia or Base mainnet. The agent wallet is Privy-managed, so there is
# no EOA private
# key here and none to export: signing happens server-side and
# ACP_PRIVY_AUTHORIZATION_KEY authorizes the request. That key still grants
# signing on the wallet — treat it as a secret and never commit a filled-in
# .env.
# ---------------------------------------------------------------------------

# 84532 (Base Sepolia) or 8453 (Base mainnet, real funds). Every other chain id
# is rejected. This also selects the Privy app, so it must agree with
# ACP_SERVER_URL: the dev host below is testnet, api.acp.virtuals.io is
# production.
# ACP_CHAIN_ID=84532

# The agent's wallet address, from its page at https://app.virtuals.io/acp.
# ACP_WALLET_ADDRESS=0x...

# The Privy wallet id backing that address. Neither value can be derived from
# the other, so both are required.
# ACP_PRIVY_WALLET_ID=...

# Privy authorization key: base64 PKCS8, no PEM headers, usually handed over
# with a `wallet-auth:` prefix. Maps to the SDK's `signerPrivateKey`.
# ACP_PRIVY_AUTHORIZATION_KEY=wallet-auth:...

# Optional. Unset, the runtime uses the SDK's testnet Privy app, which matches
# the dev ACP host. Set only if Virtuals says your agent is under another app.
# ACP_PRIVY_APP_ID=

# EVM RPC endpoint for reads and transaction receipts.
# ACP_RPC_URL=https://sepolia.base.org

# ACP host. Use the dev host for testnet; https://api.acp.virtuals.io is
# production.
# ACP_SERVER_URL=https://api-dev.acp.virtuals.io

# Whether the ACP worker may execute operator authorizations (default false).
# When unset the runtime cannot move money at all, whatever is sitting in
# acp_spend_intents. The API has no authentication, so anyone who can reach the
# port can authorize a testnet spend — keep the port local.
# ACP_SPEND_ENABLED=false

# ---------------------------------------------------------------------------
# EconomyOS Agent Compute (apps/api, `pnpm --filter @aura/api acp:compute`).
#
# Optional and independent of the marketplace: the ACP worker runs without
# these, and compute works with no ACP variables set at all.
#
# Every completion is drawn from the agent's compute balance, which auto-top-up
# refills from the same wallet that funds ACP jobs. Treat the key as a spending
# credential, not a read token.
#
# https://os.virtuals.io/agent-identity/compute/overview
# ---------------------------------------------------------------------------

# Generated from the agent's Compute settings at https://app.virtuals.io/os.
# ACP_API_KEY=acp-...

# The compute endpoint. Defaults to the shared EconomyOS gateway; set it only
# if the dashboard issued your agent a different base URL.
# ACP_COMPUTE_BASE_URL=https://compute.virtuals.io/v1
