# ---------------------------------------------------------------------------
# Copy to .env at the repository root: cp .env.example .env
# Server-side entrypoints (API, migrations, drizzle-kit) read this file.
# ---------------------------------------------------------------------------

# Host port docker-compose publishes Postgres on (default 5433, to avoid
# colliding with a Postgres already running on the conventional 5432).
POSTGRES_PORT=5433

# Postgres connection string. Matches docker-compose.yml credentials.
# Point this at any managed Postgres to skip Docker entirely.
DATABASE_URL=postgresql://aura:aura@localhost:5433/aura_console

# Optional: maximum connections in the pg pool (default 10).
# DATABASE_POOL_MAX=10

# Port the Next.js web app listens on (default 3000).
WEB_PORT=3000

# Port the Hono API listens on (default 3001).
PORT=3001

# Comma-separated list of origins allowed to call the API cross-origin.
# Must include the web app's origin, WEB_PORT included.
CORS_ORIGINS=http://localhost:3000

# Base URL the web app uses to reach the API. Exposed to the browser.
NEXT_PUBLIC_API_URL=http://localhost:3001

# ---------------------------------------------------------------------------
# ACP runtime (apps/api, `pnpm --filter @aura/api acp`).
#
# Only the ACP worker reads these. The HTTP API and the web app run without
# them, so leave them unset unless you are running the worker.
#
# TESTNET ONLY. ACP_WALLET_PRIVATE_KEY is a real signing key: it belongs to a
# throwaway Base Sepolia wallet holding test USDC and nothing else. Never put a
# key here that controls mainnet funds, and never commit a filled-in .env.
# ---------------------------------------------------------------------------

# Base Sepolia. The runtime rejects any other chain id, mainnet included.
# ACP_CHAIN_ID=84532

# The agent's wallet, registered at https://app.virtuals.io/acp/new.
# Must be the address derived from ACP_WALLET_PRIVATE_KEY.
# ACP_WALLET_ADDRESS=0x...

# Signing key for that wallet.
# ACP_WALLET_PRIVATE_KEY=0x...

# EVM RPC endpoint for reads and transaction receipts.
# ACP_RPC_URL=https://sepolia.base.org

# ACP host. Use the dev host for testnet; https://api.acp.virtuals.io is
# production.
# ACP_SERVER_URL=https://api-dev.acp.virtuals.io
