# ---------------------------------------------------------------------------
# Copy to .env at the repository root: cp .env.example .env
# Server-side entrypoints (API, migrations, drizzle-kit) read this file.
# ---------------------------------------------------------------------------

# Host port docker-compose publishes Postgres on (default 5433, to avoid
# colliding with a Postgres already running on the conventional 5432).
POSTGRES_PORT=5433

# Postgres connection string. Matches docker-compose.yml credentials.
# Point this at any managed Postgres to skip Docker entirely.
DATABASE_URL=postgresql://aura:aura@localhost:5433/aura_console

# Optional: maximum connections in the pg pool (default 10).
# DATABASE_POOL_MAX=10

# Port the Next.js web app listens on (default 3000).
WEB_PORT=3000

# Port the Hono API listens on (default 3001).
PORT=3001

# Comma-separated list of origins allowed to call the API cross-origin.
# Must include the web app's origin, WEB_PORT included.
CORS_ORIGINS=http://localhost:3000

# Base URL the web app uses to reach the API. Exposed to the browser.
NEXT_PUBLIC_API_URL=http://localhost:3001

# The operator's own agent. v0.1 is single-operator with no account model, so
# first-party access to episodes and memory diffs is established by deployment
# rather than by a session. A second operator needs real authentication.
AGENT_ID=agent_buyer_1

# Base URL of the Google ADK agent that answers operator questions, e.g.
# http://localhost:8000 for `adk api_server`. Leave it unset and the chat
# endpoint returns 503 agent_unavailable rather than inventing a reply.
# ADK_BASE_URL=http://localhost:8000

# How long to wait for the agent's first token before giving up.
ADK_TIMEOUT_MS=30000

# Sibyl Memory (optional, and unset by default on purpose).
# Sibyl ships as a Python package over a local SQLite file, so the API reaches
# it through tools/sibyl_bridge.py, which is read-only. Leave SIBYL_PYTHON unset
# and Sibyl is never consulted: retrieval passes the Postgres result through
# unchanged and reports `consulted: false` with the reason. That is not an
# error, because nothing claimed to look. Setting it opts this deployment in,
# and from then on a Sibyl that cannot answer is a memory failure rather than a
# silence — see docs/ai/api/memory.md.
#
# Sibyl needs Python 3.10 or newer (sibyl-memory-client declares
# Requires-Python: >=3.10). macOS still ships /usr/bin/python3 as 3.9, where the
# install fails, so name the interpreter explicitly rather than relying on
# whatever `python3` resolves to:
#
#   python3.11 -m venv .venv-sibyl          # 3.10+; 3.11 is what this repo uses
#   .venv-sibyl/bin/pip install sibyl-memory-client
#   .venv-sibyl/bin/python -c "import sibyl_memory_client as s; print(s.__version__)"
#
# .venv-sibyl/ and .venv-adk/ are gitignored. Neither belongs in a commit.
#
# The database is NOT created on demand. MemoryClient.local() would create the
# file, but the bridge checks for it first and reports `db_absent` instead,
# because a store conjured on a read turns "no memory here" into "an empty
# memory" — two different claims. Create one before pointing the API at it:
#
#   .venv-sibyl/bin/python tools/sibyl_seed.py     # writes the labelled fixture
#
# That seed script is the only writer in the repo and is run by hand; no request
# can reach it. The free tier needs no account: `init` only binds one.
# SIBYL_PYTHON=.venv-sibyl/bin/python
# SIBYL_DB_PATH=~/.sibyl-memory/memory.db
# SIBYL_BRIDGE=tools/sibyl_bridge.py
# SIBYL_TIMEOUT_MS=5000
