  "devDependencies": {
    "@aura/eslint-config": "workspace:*",
    "@aura/tsconfig": "workspace:*",
    "@types/node": "22.20.1",
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.5",
    "dotenv": "17.4.2",
    "eslint": "9.39.5",
    "typescript": "5.9.3"
  }
